# Domain must already resolve to this server. No https:// prefix or path.
ATOMFORGE_DOMAIN=demo.example.com
# OAuth credentials and ATOMFORGE_PUBLIC_ORIGIN belong in .env.docker,
# which compose.production.yaml loads into the application container.
ATOMFORGE_VERSION=0.3.1
AI_MAX_ACTIVE_RUNS=1
# Optional low-memory profile; prepare sufficient host swap before using it.
# APP_MEMORY_LIMIT=384m
# APP_SWAP_LIMIT=768m
# RUNNER_MEMORY_LIMIT=768m
# RUNNER_SWAP_LIMIT=1536m
