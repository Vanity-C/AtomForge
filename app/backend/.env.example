# Local development. start.ps1 creates .env.local with a random persistent secret.
DATABASE_URL=sqlite+aiosqlite:///../../.local/atomforge.db
ATOMFORGE_JWT_SECRET=replace-with-a-random-secret
MGX_IGNORE_MODULE_INIT=false
ENVIRONMENT=dev
# Optional: OpenAI-compatible provider endpoint and server-side API key.
APP_AI_BASE_URL=https://api.deepseek.com
APP_AI_KEY=
# Single-process Demo: total generation requests per hour, across all users.
AI_HOURLY_LIMIT=30

# OAuth callbacks must use this exact browser-facing origin (HTTPS in production).
ATOMFORGE_PUBLIC_ORIGIN=http://127.0.0.1:15173
ATOMFORGE_GITHUB_CLIENT_ID=
ATOMFORGE_GITHUB_CLIENT_SECRET=
ATOMFORGE_GITEE_CLIENT_ID=
ATOMFORGE_GITEE_CLIENT_SECRET=
ATOMFORGE_NETLIFY_CLIENT_ID=
ATOMFORGE_NETLIFY_CLIENT_SECRET=
