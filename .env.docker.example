# Copy to .env.docker; this file is read only at container startup.
APP_AI_BASE_URL=https://api.deepseek.com
APP_AI_KEY=
AI_HOURLY_LIMIT=30
# Optional. When omitted, a random secret is generated once in the data volume.
# ATOMFORGE_JWT_SECRET=

ATOMFORGE_PUBLIC_ORIGIN=http://127.0.0.1:8080
ATOMFORGE_GITHUB_CLIENT_ID=
ATOMFORGE_GITHUB_CLIENT_SECRET=
ATOMFORGE_GITEE_CLIENT_ID=
ATOMFORGE_GITEE_CLIENT_SECRET=
ATOMFORGE_NETLIFY_CLIENT_ID=
ATOMFORGE_NETLIFY_CLIENT_SECRET=
