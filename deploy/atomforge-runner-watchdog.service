[Unit]
Description=AtomForge isolated validation runner recovery
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/atomforge/runner-watchdog.py
TimeoutStartSec=45
StateDirectory=atomforge-runner-watchdog
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
